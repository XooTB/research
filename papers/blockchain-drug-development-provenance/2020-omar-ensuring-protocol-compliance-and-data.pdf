      <rdf:Description rdf:about="" xmlns:author="http://springernature.com/ns/xmpExtensions/2.0/authorInfo/" xmlns:sn="http://springernature.com/ns/xmpExtensions/2.0/">
         <sn:authorInfo>
            <rdf:Bag>
               <rdf:li rdf:parseType="Resource">
                  <author:name>Ibrar Yaqoob</author:name>
                  <author:orcid>http://orcid.org/0000-0002-8438-3429</author:orcid>
               </rdf:li>
